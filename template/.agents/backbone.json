{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "projectName": "my-project",
  "defaultBranch": "main",
  "ownership": "internal",
  "boundaries": {
    "workspacesRoot": "apps",
    "isolatedApps": [],
    "sharedWorkspaces": [
      "shared",
      "ui",
      "design_system"
    ],
    "packagePrefix": "@app",
    "layerRules": [
      {
        "name": "DATABASE_LEAK",
        "sourcePattern": "^(apps|web|mobile|client)/.*\\.(ts|tsx|js|jsx)$",
        "excludeFiles": [],
        "forbiddenImportTokens": [
          "server/db",
          "drizzle-orm",
          "@prisma/client",
          "postgres",
          "pg"
        ],
        "message": "Direct database/backend import detected in frontend client file. Query via public API instead."
      }
    ]
  },
  "schemas": {
    "schemaFile": "",
    "migrationDirs": [
      "drizzle/",
      "prisma/migrations/",
      "migrations/"
    ],
    "generateCommand": "yarn db:generate",
    "canonicalContractFile": ""
  },
  "graph": {
    "reportPath": "graphify-out/GRAPH_REPORT.md",
    "enforceZeroCycles": true
  },
  "design": "templates/design.md",
  "commands": {
    "decide": "node scripts/decide.mjs",
    "guard": "yarn guard:domain",
    "astScan": "yarn ast:scan",
    "astTest": "yarn ast:test",
    "graphUpdate": "yarn graph:update",
    "graphBuild": "yarn graph:build",
    "typecheck": "yarn typecheck",
    "test": "yarn test"
  },
  "guardians": [
    {
      "domain": "template",
      "label": "Core Domain Template",
      "ontologyAgent": ".agents/agents/ontology-template-guardian.md",
      "businessAgent": ".agents/agents/business-template-guardian.md",
      "triggers": [
        "domain",
        "schema"
      ]
    }
  ]
}
